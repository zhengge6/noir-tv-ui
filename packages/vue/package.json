{
  "name": "@noir-tv-ui/vue",
  "version": "0.2.0",
  "description": "Vue 3 bindings for NOIR TV UI: typed Hero, PosterRow, PosterCard, Pill, NavBar, BottomSheet and a WebView-safe useBackStack composable.",
  "license": "MIT",
  "author": "zhengge6",
  "repository": { "type": "git", "url": "git+https://github.com/zhengge6/noir-tv-ui.git", "directory": "packages/vue" },
  "homepage": "https://zhengge6.github.io/noir-tv-ui/demo/vue/",
  "keywords": ["vue", "vue3", "ui-kit", "tv", "android-tv", "webview", "d-pad"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "sideEffects": ["./dist/noir.js"],
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noir-tv-ui/core": "0.2.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vue": "^3.5.0"
  }
}
